# ─── Agentic Commerce Environment Configuration ───────────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets.

# Environment mode: development | test | production
APP_ENV=development

# Razorpay Test-Mode Keys (obtain from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini API
GEMINI_API_KEY=

# Security — JWT signing secret (min 32 chars in production)
JWT_SECRET=change-me-in-production

# Operator Login — set via environment, NEVER hardcode in source
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# Payment Simulation — must be false in production
PAYMENT_SIMULATION_ENABLED=true

# Database — PostgreSQL required in production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_commerce

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
